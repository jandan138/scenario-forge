{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenario-forge.local/schemas/task-readiness-snapshot-v0.1.schema.json",
  "title": "Scenario Forge Task Readiness Snapshot v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "captured_at",
    "catalog_source",
    "assets",
    "tasks"
  ],
  "properties": {
    "schema_version": {"const": "task-readiness-snapshot/v0.1"},
    "snapshot_id": {"$ref": "#/$defs/id"},
    "captured_at": {"type": "string", "format": "date"},
    "catalog_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog_id", "catalog_path", "source_sha256"],
      "properties": {
        "catalog_id": {"$ref": "#/$defs/id"},
        "catalog_path": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/assetReadiness"}
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/taskReadiness"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "status": {
      "enum": ["passed", "pending", "blocked", "not_run", "not_required"]
    },
    "stringList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "assetReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_role",
        "candidate_identity",
        "context_package_status",
        "interactive_affordance_status",
        "pending_affordances",
        "blockers"
      ],
      "properties": {
        "asset_role": {"$ref": "#/$defs/id"},
        "candidate_identity": {"type": ["string", "null"]},
        "context_package_status": {"$ref": "#/$defs/status"},
        "interactive_affordance_status": {"$ref": "#/$defs/status"},
        "pending_affordances": {"$ref": "#/$defs/stringList"},
        "blockers": {"$ref": "#/$defs/stringList"}
      }
    },
    "taskReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "compile_status",
        "runtime_reset_status",
        "oracle_status",
        "blockers",
        "next_action"
      ],
      "properties": {
        "task_id": {"$ref": "#/$defs/id"},
        "compile_status": {"$ref": "#/$defs/status"},
        "runtime_reset_status": {"$ref": "#/$defs/status"},
        "oracle_status": {"$ref": "#/$defs/status"},
        "blockers": {"$ref": "#/$defs/stringList"},
        "next_action": {"type": "string", "minLength": 1}
      }
    }
  }
}
