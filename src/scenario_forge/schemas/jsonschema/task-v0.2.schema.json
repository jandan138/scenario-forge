{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenario-forge.local/schemas/task-v0.2.schema.json",
  "title": "Scenario Forge Task v0.2",
  "type": "object",
  "required": ["schema_version", "task_id", "task_family", "instruction", "bindings"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": "task/v0.2"},
    "task_id": {"type": "string", "minLength": 1},
    "task_family": {"type": "string", "minLength": 1},
    "instruction": {"type": "string", "minLength": 1},
    "bindings": {"type": "object"}
  }
}
