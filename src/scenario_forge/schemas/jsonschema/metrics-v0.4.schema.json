{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenario-forge.dev/schemas/metrics-v0.4.schema.json",
  "title": "Scenario Forge Package Metrics v0.4",
  "type": "object",
  "required": [
    "schema_version",
    "aggregation",
    "metrics"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "metrics/v0.4"
    },
    "aggregation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "normalization",
        "inactive_treatment"
      ],
      "properties": {
        "type": {
          "const": "weighted_progress_score"
        },
        "normalization": {
          "enum": [
            "declared_sum",
            "active_subset_renormalize"
          ]
        },
        "inactive_treatment": {
          "enum": [
            "zero",
            "exclude"
          ]
        },
        "primary_metric_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "role",
          "weight",
          "active",
          "temporal",
          "condition"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "const": "rubric_condition"
          },
          "role": {
            "const": "progress_component"
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "active": {
            "type": "boolean"
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "temporal": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "instant",
                  "sustained",
                  "terminal"
                ]
              },
              "window": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "from_step",
                  "through_step"
                ],
                "properties": {
                  "from_step": {
                    "type": "string",
                    "minLength": 1
                  },
                  "through_step": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "condition": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "parameters"
            ],
            "properties": {
              "type": {
                "enum": [
                  "object_lifted",
                  "pose_while_grasped",
                  "object_released_on_support",
                  "liquid_transfer_ratio",
                  "relative_pose_reached",
                  "object_at_initial_pose",
                  "motion_trajectory_completed",
                  "articulation_joint_state_reached"
                ]
              },
              "parameters": {
                "type": "object"
              }
            }
          },
          "source_ref": {
            "type": "object"
          }
        }
      }
    }
  }
}
