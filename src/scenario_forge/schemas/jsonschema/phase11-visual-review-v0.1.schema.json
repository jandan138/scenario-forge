{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenario-forge.local/schemas/phase11-visual-review-v0.1.schema.json",
  "title": "Scenario Forge Phase 11 Visual Review v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "reviewer",
    "review_mode",
    "image_path",
    "verdict",
    "visible_evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "phase11-visual-review/v0.1"
    },
    "reviewer": {
      "const": "render-visual-reviewer"
    },
    "review_mode": {
      "const": "clean_room_visual_skill"
    },
    "image_path": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "enum": ["PASS", "WARN", "FAIL"]
    },
    "visible_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "retake_recommendation": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
