{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenario-forge.local/schemas/phase11-executed-episode-gate-v0.1.schema.json",
  "title": "Scenario Forge Phase 11 Executed Episode Gate v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "phase",
    "status",
    "package_id",
    "task_id",
    "episode",
    "blockers",
    "next_stage",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "phase11-executed-episode-gate/v0.1"
    },
    "phase": {
      "const": "11.2"
    },
    "status": {
      "enum": ["passed", "failed"]
    },
    "package_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "episode": {
      "type": "object"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_stage": {
      "enum": ["success_predicate_evaluation_gate", "blocked"]
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
