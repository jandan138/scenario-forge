{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenario-forge.local/schemas/scenario-package-v0.1.schema.json",
  "title": "Scenario Forge Package Manifest",
  "type": "object",
  "required": ["schema_version", "scenario_id", "exports", "files"],
  "properties": {
    "schema_version": {
      "const": "scenario-package/v0.1"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "scenario_domain": {
      "type": "string"
    },
    "exports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["ebench", "embodied-eval-os"]
      }
    },
    "files": {
      "type": "object",
      "required": ["scene", "instances", "task", "robot", "validation_report"],
      "properties": {
        "scene": {"type": "string"},
        "instances": {"type": "string"},
        "task": {"type": "string"},
        "robot": {"type": "string"},
        "validation_report": {"type": "string"}
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
