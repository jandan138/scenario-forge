{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenario-forge.local/schemas/scenario-forge-genmanip-runtime-contract-v0.6.schema.json",
  "title": "Scenario Forge GenManip Runtime Contract v0.6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_status",
    "scenario_id",
    "task_name",
    "episode_name",
    "coordinate_convention",
    "execution",
    "robot",
    "objects",
    "steps",
    "invariants",
    "success"
  ],
  "properties": {
    "schema_version": {
      "const": "scenario-forge-genmanip-runtime-contract/v0.6"
    },
    "contract_status": {"const": "transport_only"},
    "scenario_id": {"$ref": "#/$defs/usdIdentifier"},
    "task_name": {"$ref": "#/$defs/nonEmptyString"},
    "episode_name": {"$ref": "#/$defs/portableId"},
    "coordinate_convention": {"$ref": "#/$defs/coordinateConvention"},
    "execution": {"$ref": "#/$defs/execution"},
    "robot": {"$ref": "#/$defs/robot"},
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/object"}
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/step"}
    },
    "invariants": {
      "type": "array",
      "items": {"$ref": "#/$defs/invariant"}
    },
    "success": {"$ref": "#/$defs/success"}
  },
  "$defs": {
    "portableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "usdIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "number3": {
      "type": "array",
      "prefixItems": [
        {"type": "number"},
        {"type": "number"},
        {"type": "number"}
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "quaternion": {
      "type": "array",
      "prefixItems": [
        {"type": "number"},
        {"type": "number"},
        {"type": "number"},
        {"type": "number"}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4,
      "not": {"const": [0, 0, 0, 0]}
    },
    "pose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["xyz", "wxyz"],
      "properties": {
        "xyz": {"$ref": "#/$defs/number3"},
        "wxyz": {"$ref": "#/$defs/quaternion"},
        "scale_xyz": {"$ref": "#/$defs/number3"}
      }
    },
    "framePose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["xyz", "wxyz"],
      "properties": {
        "xyz": {"$ref": "#/$defs/number3"},
        "wxyz": {"$ref": "#/$defs/quaternion"}
      }
    },
    "articulationFrame": {
      "description": "An authoritative frame expressed in the local coordinates of an articulation prim. Unlike object named_frames, the parent may be a moving articulation part.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_prim",
        "translation_parent_local_m",
        "rotation_parent_local_wxyz",
        "authoritative"
      ],
      "properties": {
        "parent_prim": {"type": "string", "pattern": "^/"},
        "translation_parent_local_m": {"$ref": "#/$defs/number3"},
        "rotation_parent_local_wxyz": {"$ref": "#/$defs/quaternion"},
        "authoritative": {"const": true}
      }
    },
    "numberRange": {
      "type": "array",
      "prefixItems": [
        {"type": "number"},
        {"type": "number"}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "coordinateConvention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "translation_unit",
        "quaternion_order",
        "named_frame_pose_relative_to",
        "transform_direction",
        "frame_scale_allowed"
      ],
      "properties": {
        "translation_unit": {"const": "meter"},
        "quaternion_order": {"const": "wxyz"},
        "named_frame_pose_relative_to": {"const": "state_prim_path"},
        "transform_direction": {"const": "state_prim_from_named_frame"},
        "frame_scale_allowed": {"const": false}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native_goal_role",
        "frame_aware_metric_active",
        "process_invariants_evaluated"
      ],
      "properties": {
        "native_goal_role": {
          "enum": [
            "diagnostic_compatibility_projection",
            "native_articulation_status_with_diagnostic_compatibility_projection"
          ]
        },
        "frame_aware_metric_active": {"const": false},
        "process_invariants_evaluated": {"const": false},
        "progress_rubric": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scored_here", "unevaluated_metric_ids"],
          "properties": {
            "scored_here": {"const": false},
            "unevaluated_metric_ids": {
              "type": "array",
              "items": {"$ref": "#/$defs/nonEmptyString"},
              "uniqueItems": true
            }
          }
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "end_effector", "capabilities"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "end_effector": {"$ref": "#/$defs/nonEmptyString"},
        "capabilities": {
          "type": "array",
          "items": {"$ref": "#/$defs/nonEmptyString"}
        }
      }
    },
    "robot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_ref", "robot_index", "actors"],
      "properties": {
        "profile_ref": {"$ref": "#/$defs/nonEmptyString"},
        "robot_index": {"const": 0},
        "actors": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/actor"}
        }
      }
    },
    "physicsAuthoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "local_colliders", "local_rigid_body", "local_mass"],
      "properties": {
        "owner": {"const": "convert_asset_package"},
        "local_colliders": {"const": false},
        "local_rigid_body": {"const": false},
        "local_mass": {"const": false}
      }
    },
    "dofMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_joint", "joint_prim", "dof_index"],
      "properties": {
        "semantic_joint": {"$ref": "#/$defs/nonEmptyString"},
        "joint_prim": {
          "type": "string",
          "pattern": "^/"
        },
        "dof_index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "jointStates": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/nonEmptyString"},
      "additionalProperties": {"$ref": "#/$defs/numberRange"}
    },
    "articulationStates": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/nonEmptyString"},
      "additionalProperties": {"$ref": "#/$defs/jointStates"}
    },
    "articulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_prim_path",
        "runtime_units",
        "dof_mapping",
        "reset_joint_positions",
        "states"
      ],
      "properties": {
        "root_prim_path": {
          "type": "string",
          "pattern": "^/"
        },
        "runtime_units": {
          "description": "Units for all reset positions and semantic state ranges in this runtime articulation contract.",
          "type": "object",
          "additionalProperties": false,
          "required": ["revolute", "prismatic"],
          "properties": {
            "revolute": {"const": "radian"},
            "prismatic": {"const": "meter"}
          }
        },
        "dof_mapping": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/dofMapping"}
        },
        "reset_joint_positions": {
          "description": "Runtime DOF positions ordered by dof_mapping; revolute values are radians and prismatic values are meters.",
          "type": "array",
          "minItems": 1,
          "items": {"type": "number"}
        },
        "states": {
          "description": "Inclusive runtime-unit ranges keyed by semantic joint and state; revolute values are radians and prismatic values are meters.",
          "$ref": "#/$defs/articulationStates"
        },
        "named_frames": {
          "description": "Authoritative interaction frames retained from the ConvertAsset articulation contract, including frames parented to moving parts.",
          "type": "object",
          "propertyNames": {"type": "string", "minLength": 1, "pattern": "^[^.]+$"},
          "additionalProperties": {"$ref": "#/$defs/articulationFrame"}
        }
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_object_id",
        "role",
        "source_prim_path",
        "runtime_uid",
        "state_prim_path",
        "initial_pose",
        "named_frames"
      ],
      "properties": {
        "scenario_object_id": {"$ref": "#/$defs/usdIdentifier"},
        "role": {"$ref": "#/$defs/nonEmptyString"},
        "source_prim_path": {
          "type": "string",
          "pattern": "^/"
        },
        "runtime_uid": {"$ref": "#/$defs/nonEmptyString"},
        "state_prim_path": {
          "type": "string",
          "pattern": "^/World/"
        },
        "initial_pose": {"$ref": "#/$defs/pose"},
        "named_frames": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^.]+$"
          },
          "additionalProperties": {"$ref": "#/$defs/framePose"}
        },
        "physics_authoring": {"$ref": "#/$defs/physicsAuthoring"},
        "articulation": {"$ref": "#/$defs/articulation"}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "skill", "actors", "parameters"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "skill": {"$ref": "#/$defs/nonEmptyString"},
        "actors": {
          "type": "array",
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "parameters": {"type": "object"},
        "depends_on": {
          "type": "array",
          "items": {"$ref": "#/$defs/nonEmptyString"}
        }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "actor", "object", "from_step", "through_step"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "type": {"$ref": "#/$defs/nonEmptyString"},
        "actor": {"$ref": "#/$defs/nonEmptyString"},
        "object": {"$ref": "#/$defs/nonEmptyString"},
        "from_step": {"$ref": "#/$defs/nonEmptyString"},
        "through_step": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "relativePosePredicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "sequence_index", "parameters"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "type": {"const": "relative_pose_reached"},
        "sequence_index": {"type": "integer", "minimum": 0},
        "parameters": {"type": "object"}
      }
    },
    "objectAtInitialPosePredicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "sequence_index", "parameters"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "type": {"const": "object_at_initial_pose"},
        "sequence_index": {"type": "integer", "minimum": 0},
        "parameters": {"type": "object"}
      }
    },
    "articulationJointStatePredicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "sequence_index", "parameters"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "type": {"const": "articulation_joint_state_reached"},
        "sequence_index": {"type": "integer", "minimum": 0},
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["object", "joint", "state"],
          "properties": {
            "object": {"$ref": "#/$defs/nonEmptyString"},
            "joint": {"$ref": "#/$defs/nonEmptyString"},
            "state": {"$ref": "#/$defs/nonEmptyString"}
          }
        }
      }
    },
    "successPredicate": {
      "oneOf": [
        {"$ref": "#/$defs/relativePosePredicate"},
        {"$ref": "#/$defs/objectAtInitialPosePredicate"},
        {"$ref": "#/$defs/articulationJointStatePredicate"}
      ]
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "claim_scope", "predicates"],
      "properties": {
        "operator": {"enum": ["all", "any"]},
        "claim_scope": {"$ref": "#/$defs/nonEmptyString"},
        "predicates": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/successPredicate"}
        },
        "progress_rubric": {"$ref": "#/$defs/progressRubric"}
      }
    },
    "progressRubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregation", "items"],
      "properties": {
        "aggregation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "normalization", "inactive_treatment"],
          "properties": {
            "type": {"const": "weighted_progress_score"},
            "normalization": {
              "enum": ["declared_sum", "active_subset_renormalize"]
            },
            "inactive_treatment": {"enum": ["zero", "exclude"]},
            "primary_metric_id": {"$ref": "#/$defs/nonEmptyString"}
          }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/progressRubricItem"}
        }
      }
    },
    "progressRubricItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "weight", "temporal", "condition"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "active": {"type": "boolean"},
        "requires": {
          "type": "array",
          "items": {"$ref": "#/$defs/nonEmptyString"},
          "uniqueItems": true
        },
        "temporal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {"enum": ["instant", "sustained", "terminal"]},
            "window": {
              "type": "object",
              "additionalProperties": false,
              "required": ["from_step", "through_step"],
              "properties": {
                "from_step": {"$ref": "#/$defs/nonEmptyString"},
                "through_step": {"$ref": "#/$defs/nonEmptyString"}
              }
            }
          }
        },
        "condition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "parameters"],
          "properties": {
            "type": {
              "enum": [
                "object_lifted",
                "pose_while_grasped",
                "object_released_on_support",
                "liquid_transfer_ratio",
                "relative_pose_reached",
                "object_at_initial_pose",
                "motion_trajectory_completed",
                "articulation_joint_state_reached"
              ]
            },
            "parameters": {"type": "object"}
          }
        },
        "source_ref": {"type": "object"}
      }
    }
  }
}
