{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenario-forge.local/schemas/task-v0.3.schema.json",
  "title": "Scenario Forge Task v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "task_family",
    "instruction",
    "bindings",
    "steps",
    "invariants",
    "success",
    "max_steps",
    "seed"
  ],
  "properties": {
    "schema_version": {
      "const": "task/v0.5"
    },
    "task_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "task_family": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "instruction": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "bindings": {
      "$ref": "#/$defs/bindings"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/taskStep"
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/invariant"
      }
    },
    "success": {
      "$ref": "#/$defs/exactBimanualSuccessV04"
    },
    "max_steps": {
      "type": "integer",
      "minimum": 1
    },
    "seed": {
      "oneOf": [
        {
          "$ref": "#/$defs/packageSegment"
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "packageSegment": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "stringMap": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objects",
        "actors"
      ],
      "properties": {
        "objects": {
          "$ref": "#/$defs/stringMap"
        },
        "actors": {
          "$ref": "#/$defs/stringMap"
        }
      }
    },
    "taskStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "skill",
        "actors",
        "parameters"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "skill": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "actors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        },
        "parameters": {
          "type": "object"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "actor",
        "object",
        "from_step",
        "through_step"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "type": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "actor": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "object": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "from_step": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "through_step": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "vector3": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "quaternion": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "framePose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "xyz",
        "wxyz"
      ],
      "properties": {
        "xyz": {
          "$ref": "#/$defs/vector3"
        },
        "wxyz": {
          "$ref": "#/$defs/quaternion"
        }
      }
    },
    "numberRange": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "polarAngleRange": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 180
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "azimuthAngleRange": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "sourceOriginRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "$ref": "#/$defs/numberRange"
        },
        "y": {
          "$ref": "#/$defs/numberRange"
        },
        "z": {
          "$ref": "#/$defs/numberRange"
        }
      }
    },
    "diagnosticCompatibilityProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "parameters"
      ],
      "properties": {
        "type": {
          "enum": [
            "relative_pose_reached",
            "object_at_initial_pose"
          ]
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "relativePoseParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_frame",
        "target_frame",
        "target_frame_from_source_frame_nominal_pose",
        "source_origin_in_target_frame_range_m",
        "source_normal_axis",
        "target_normal_axis",
        "source_normal_polar_angle_range_deg",
        "source_normal_azimuth_range_deg",
        "bounds",
        "diagnostic_compatibility_projection"
      ],
      "properties": {
        "source_frame": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "target_frame": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "target_frame_from_source_frame_nominal_pose": {
          "$ref": "#/$defs/framePose"
        },
        "source_origin_in_target_frame_range_m": {
          "$ref": "#/$defs/sourceOriginRange"
        },
        "source_normal_axis": {
          "const": "z"
        },
        "target_normal_axis": {
          "const": "z"
        },
        "source_normal_polar_angle_range_deg": {
          "$ref": "#/$defs/polarAngleRange"
        },
        "source_normal_azimuth_range_deg": {
          "$ref": "#/$defs/azimuthAngleRange"
        },
        "bounds": {
          "const": "inclusive"
        },
        "diagnostic_compatibility_projection": {
          "$ref": "#/$defs/diagnosticCompatibilityProjection"
        }
      }
    },
    "namedFramesRelativePosePredicateSequence0": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "sequence_index",
        "parameters"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "type": {
          "const": "named_frames_relative_pose_reached"
        },
        "sequence_index": {
          "const": 0
        },
        "parameters": {
          "$ref": "#/$defs/relativePoseParameters"
        }
      }
    },
    "namedFramesRelativePosePredicateSequence1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "sequence_index",
        "parameters"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "type": {
          "const": "named_frames_relative_pose_reached"
        },
        "sequence_index": {
          "const": 1
        },
        "parameters": {
          "$ref": "#/$defs/relativePoseParameters"
        }
      }
    },
    "postWarmupReturnPredicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "sequence_index",
        "parameters"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "type": {
          "const": "object_returned_to_post_warmup_pose"
        },
        "sequence_index": {
          "const": 2
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "object",
            "translation_error_max_m",
            "rotation_error_max_deg",
            "bounds",
            "diagnostic_compatibility_projection"
          ],
          "properties": {
            "object": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "translation_error_max_m": {
              "type": "number",
              "minimum": 0
            },
            "rotation_error_max_deg": {
              "type": "number",
              "minimum": 0,
              "maximum": 180
            },
            "bounds": {
              "const": "inclusive"
            },
            "diagnostic_compatibility_projection": {
              "$ref": "#/$defs/diagnosticCompatibilityProjection"
            }
          }
        }
      }
    },
    "exactBimanualSuccess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator",
        "claim_scope",
        "predicates"
      ],
      "properties": {
        "operator": {
          "const": "all"
        },
        "claim_scope": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "predicates": {
          "type": "array",
          "prefixItems": [
            {
              "$ref": "#/$defs/namedFramesRelativePosePredicateSequence0"
            },
            {
              "$ref": "#/$defs/namedFramesRelativePosePredicateSequence1"
            },
            {
              "$ref": "#/$defs/postWarmupReturnPredicate"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "exactBimanualSuccessV04": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator",
        "claim_scope",
        "predicates"
      ],
      "properties": {
        "operator": {
          "const": "all"
        },
        "claim_scope": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "predicates": {
          "type": "array",
          "prefixItems": [
            {
              "$ref": "#/$defs/namedFramesRelativePosePredicateSequence0"
            },
            {
              "$ref": "#/$defs/namedFramesRelativePosePredicateSequence1"
            },
            {
              "$ref": "#/$defs/postWarmupReturnPredicate"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "progress_rubric": {
          "$ref": "#/$defs/progressRubric"
        }
      }
    },
    "progressRubric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregation",
        "items"
      ],
      "properties": {
        "aggregation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "normalization",
            "inactive_treatment"
          ],
          "properties": {
            "type": {
              "const": "weighted_progress_score"
            },
            "normalization": {
              "enum": [
                "declared_sum",
                "active_subset_renormalize"
              ]
            },
            "inactive_treatment": {
              "enum": [
                "zero",
                "exclude"
              ]
            },
            "primary_metric_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/progressRubricItem"
          }
        }
      }
    },
    "progressRubricItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "weight",
        "temporal",
        "condition"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "active": {
          "type": "boolean"
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "temporal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "instant",
                "sustained",
                "terminal"
              ]
            },
            "window": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from_step",
                "through_step"
              ],
              "properties": {
                "from_step": {
                  "type": "string",
                  "minLength": 1
                },
                "through_step": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "condition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "parameters"
          ],
          "properties": {
            "type": {
              "enum": [
                "object_lifted",
                "pose_while_grasped",
                "object_released_on_support",
                "liquid_transfer_ratio",
                "relative_pose_reached",
                "object_at_initial_pose",
                "motion_trajectory_completed",
                "articulation_joint_state_reached"
              ]
            },
            "parameters": {
              "type": "object"
            }
          }
        },
        "source_ref": {
          "type": "object"
        }
      }
    }
  }
}
