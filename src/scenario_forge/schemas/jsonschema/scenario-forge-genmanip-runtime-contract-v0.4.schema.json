{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenario-forge.local/schemas/scenario-forge-genmanip-runtime-contract-v0.3.schema.json",
  "title": "Scenario Forge GenManip Runtime Contract v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_status",
    "scenario_id",
    "task_name",
    "episode_name",
    "coordinate_convention",
    "execution",
    "robot",
    "objects",
    "steps",
    "invariants",
    "success"
  ],
  "properties": {
    "schema_version": {
      "const": "scenario-forge-genmanip-runtime-contract/v0.4"
    },
    "contract_status": {
      "const": "transport_only"
    },
    "scenario_id": {
      "$ref": "#/$defs/usdIdentifier"
    },
    "task_name": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "episode_name": {
      "$ref": "#/$defs/portableId"
    },
    "coordinate_convention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "translation_unit",
        "quaternion_order",
        "named_frame_pose_relative_to",
        "transform_direction",
        "frame_scale_allowed"
      ],
      "properties": {
        "translation_unit": {
          "const": "meter"
        },
        "quaternion_order": {
          "const": "wxyz"
        },
        "named_frame_pose_relative_to": {
          "const": "state_prim_path"
        },
        "transform_direction": {
          "const": "state_prim_from_named_frame"
        },
        "frame_scale_allowed": {
          "const": false
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native_goal_role",
        "frame_aware_metric_active",
        "process_invariants_evaluated"
      ],
      "properties": {
        "native_goal_role": {
          "const": "diagnostic_compatibility_projection"
        },
        "frame_aware_metric_active": {
          "const": false
        },
        "process_invariants_evaluated": {
          "const": false
        },
        "progress_rubric": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scored_here",
            "unevaluated_metric_ids"
          ],
          "properties": {
            "scored_here": {
              "const": false
            },
            "unevaluated_metric_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "robot": {
      "$ref": "#/$defs/robot"
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/object"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/invariant"
      }
    },
    "success": {
      "$ref": "#/$defs/exactBimanualSuccessV04"
    }
  },
  "$defs": {
    "portableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "usdIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "number3": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "quaternion": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4,
      "not": {
        "const": [
          0,
          0,
          0,
          0
        ]
      }
    },
    "pose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "xyz",
        "wxyz"
      ],
      "properties": {
        "xyz": {
          "$ref": "#/$defs/number3"
        },
        "wxyz": {
          "$ref": "#/$defs/quaternion"
        },
        "scale_xyz": {
          "$ref": "#/$defs/number3"
        }
      }
    },
    "framePose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "xyz",
        "wxyz"
      ],
      "properties": {
        "xyz": {
          "$ref": "#/$defs/number3"
        },
        "wxyz": {
          "$ref": "#/$defs/quaternion"
        }
      }
    },
    "numberRange": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "polarAngleRange": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 180
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "azimuthAngleRange": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "sourceOriginRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "$ref": "#/$defs/numberRange"
        },
        "y": {
          "$ref": "#/$defs/numberRange"
        },
        "z": {
          "$ref": "#/$defs/numberRange"
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "end_effector",
        "capabilities"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "end_effector": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "robot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_ref",
        "robot_index",
        "actors"
      ],
      "properties": {
        "profile_ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "robot_index": {
          "const": 0
        },
        "actors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/actor"
          }
        }
      }
    },
    "physicsAuthoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "local_colliders",
        "local_rigid_body",
        "local_mass"
      ],
      "properties": {
        "owner": {
          "const": "convert_asset_package"
        },
        "local_colliders": {
          "const": false
        },
        "local_rigid_body": {
          "const": false
        },
        "local_mass": {
          "const": false
        }
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_object_id",
        "role",
        "source_prim_path",
        "runtime_uid",
        "state_prim_path",
        "initial_pose",
        "named_frames"
      ],
      "properties": {
        "scenario_object_id": {
          "$ref": "#/$defs/usdIdentifier"
        },
        "role": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_prim_path": {
          "type": "string",
          "pattern": "^/"
        },
        "runtime_uid": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "state_prim_path": {
          "type": "string",
          "pattern": "^/World/"
        },
        "initial_pose": {
          "$ref": "#/$defs/pose"
        },
        "named_frames": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^.]+$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/framePose"
          }
        },
        "physics_authoring": {
          "$ref": "#/$defs/physicsAuthoring"
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "skill",
        "actors",
        "parameters"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "skill": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "actors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "parameters": {
          "type": "object"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "actor",
        "object",
        "from_step",
        "through_step"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "type": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "actor": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "object": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "from_step": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "through_step": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "diagnosticCompatibilityProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "parameters"
      ],
      "properties": {
        "type": {
          "enum": [
            "relative_pose_reached",
            "object_at_initial_pose"
          ]
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "relativePoseParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_frame",
        "target_frame",
        "target_frame_from_source_frame_nominal_pose",
        "source_origin_in_target_frame_range_m",
        "source_normal_axis",
        "target_normal_axis",
        "source_normal_polar_angle_range_deg",
        "source_normal_azimuth_range_deg",
        "bounds",
        "diagnostic_compatibility_projection"
      ],
      "properties": {
        "source_frame": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "target_frame": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "target_frame_from_source_frame_nominal_pose": {
          "$ref": "#/$defs/framePose"
        },
        "source_origin_in_target_frame_range_m": {
          "$ref": "#/$defs/sourceOriginRange"
        },
        "source_normal_axis": {
          "const": "z"
        },
        "target_normal_axis": {
          "const": "z"
        },
        "source_normal_polar_angle_range_deg": {
          "$ref": "#/$defs/polarAngleRange"
        },
        "source_normal_azimuth_range_deg": {
          "$ref": "#/$defs/azimuthAngleRange"
        },
        "bounds": {
          "const": "inclusive"
        },
        "diagnostic_compatibility_projection": {
          "$ref": "#/$defs/diagnosticCompatibilityProjection"
        }
      }
    },
    "namedFramesRelativePosePredicateSequence0": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "sequence_index",
        "parameters"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "type": {
          "const": "named_frames_relative_pose_reached"
        },
        "sequence_index": {
          "const": 0
        },
        "parameters": {
          "$ref": "#/$defs/relativePoseParameters"
        }
      }
    },
    "namedFramesRelativePosePredicateSequence1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "sequence_index",
        "parameters"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "type": {
          "const": "named_frames_relative_pose_reached"
        },
        "sequence_index": {
          "const": 1
        },
        "parameters": {
          "$ref": "#/$defs/relativePoseParameters"
        }
      }
    },
    "postWarmupReturnPredicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "sequence_index",
        "parameters"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "type": {
          "const": "object_returned_to_post_warmup_pose"
        },
        "sequence_index": {
          "const": 2
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "object",
            "translation_error_max_m",
            "rotation_error_max_deg",
            "bounds",
            "diagnostic_compatibility_projection"
          ],
          "properties": {
            "object": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "translation_error_max_m": {
              "type": "number",
              "minimum": 0
            },
            "rotation_error_max_deg": {
              "type": "number",
              "minimum": 0,
              "maximum": 180
            },
            "bounds": {
              "const": "inclusive"
            },
            "diagnostic_compatibility_projection": {
              "$ref": "#/$defs/diagnosticCompatibilityProjection"
            }
          }
        }
      }
    },
    "exactBimanualSuccess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator",
        "claim_scope",
        "predicates"
      ],
      "properties": {
        "operator": {
          "const": "all"
        },
        "claim_scope": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "predicates": {
          "type": "array",
          "prefixItems": [
            {
              "$ref": "#/$defs/namedFramesRelativePosePredicateSequence0"
            },
            {
              "$ref": "#/$defs/namedFramesRelativePosePredicateSequence1"
            },
            {
              "$ref": "#/$defs/postWarmupReturnPredicate"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "exactBimanualSuccessV04": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator",
        "claim_scope",
        "predicates"
      ],
      "properties": {
        "operator": {
          "const": "all"
        },
        "claim_scope": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "predicates": {
          "type": "array",
          "prefixItems": [
            {
              "$ref": "#/$defs/namedFramesRelativePosePredicateSequence0"
            },
            {
              "$ref": "#/$defs/namedFramesRelativePosePredicateSequence1"
            },
            {
              "$ref": "#/$defs/postWarmupReturnPredicate"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "progress_rubric": {
          "$ref": "#/$defs/progressRubric"
        }
      }
    },
    "progressRubric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregation",
        "items"
      ],
      "properties": {
        "aggregation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "normalization",
            "inactive_treatment"
          ],
          "properties": {
            "type": {
              "const": "weighted_progress_score"
            },
            "normalization": {
              "enum": [
                "declared_sum",
                "active_subset_renormalize"
              ]
            },
            "inactive_treatment": {
              "enum": [
                "zero",
                "exclude"
              ]
            },
            "primary_metric_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/progressRubricItem"
          }
        }
      }
    },
    "progressRubricItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "weight",
        "temporal",
        "condition"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "active": {
          "type": "boolean"
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "temporal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "instant",
                "sustained",
                "terminal"
              ]
            },
            "window": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from_step",
                "through_step"
              ],
              "properties": {
                "from_step": {
                  "type": "string",
                  "minLength": 1
                },
                "through_step": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "condition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "parameters"
          ],
          "properties": {
            "type": {
              "enum": [
                "object_lifted",
                "pose_while_grasped",
                "object_released_on_support",
                "liquid_transfer_ratio"
              ]
            },
            "parameters": {
              "type": "object"
            }
          }
        },
        "source_ref": {
          "type": "object"
        }
      }
    }
  }
}
