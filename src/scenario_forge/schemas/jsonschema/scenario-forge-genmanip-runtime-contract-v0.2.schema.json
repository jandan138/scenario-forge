{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenario-forge.local/schemas/scenario-forge-genmanip-runtime-contract-v0.2.schema.json",
  "title": "Scenario Forge GenManip Runtime Contract v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_status",
    "scenario_id",
    "task_name",
    "episode_name",
    "coordinate_convention",
    "execution",
    "robot",
    "objects",
    "steps",
    "invariants",
    "success"
  ],
  "properties": {
    "schema_version": {"const": "scenario-forge-genmanip-runtime-contract/v0.2"},
    "contract_status": {"const": "transport_only"},
    "scenario_id": {"$ref": "#/$defs/usdIdentifier"},
    "task_name": {"type": "string", "minLength": 1},
    "episode_name": {"$ref": "#/$defs/portableId"},
    "coordinate_convention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "translation_unit",
        "quaternion_order",
        "named_frame_pose_relative_to",
        "transform_direction",
        "frame_scale_allowed"
      ],
      "properties": {
        "translation_unit": {"const": "meter"},
        "quaternion_order": {"const": "wxyz"},
        "named_frame_pose_relative_to": {"const": "state_prim_path"},
        "transform_direction": {"const": "state_prim_from_named_frame"},
        "frame_scale_allowed": {"const": false}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native_goal_role",
        "frame_aware_metric_active",
        "process_invariants_evaluated"
      ],
      "properties": {
        "native_goal_role": {"const": "diagnostic_compatibility_projection"},
        "frame_aware_metric_active": {"const": false},
        "process_invariants_evaluated": {"const": false}
      }
    },
    "robot": {"$ref": "#/$defs/robot"},
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/object"}
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/step"}
    },
    "invariants": {
      "type": "array",
      "items": {"$ref": "#/$defs/invariant"}
    },
    "success": {"$ref": "#/$defs/success"}
  },
  "$defs": {
    "portableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "usdIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "nonEmptyString": {"type": "string", "minLength": 1},
    "number3": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "quaternion": {
      "type": "array",
      "prefixItems": [
        {"type": "number"},
        {"type": "number"},
        {"type": "number"},
        {"type": "number"}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4,
      "not": {"const": [0, 0, 0, 0]}
    },
    "pose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["xyz", "wxyz"],
      "properties": {
        "xyz": {"$ref": "#/$defs/number3"},
        "wxyz": {"$ref": "#/$defs/quaternion"},
        "scale_xyz": {"$ref": "#/$defs/number3"}
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "end_effector", "capabilities"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "end_effector": {"$ref": "#/$defs/nonEmptyString"},
        "capabilities": {
          "type": "array",
          "items": {"$ref": "#/$defs/nonEmptyString"}
        }
      }
    },
    "robot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_ref", "robot_index", "actors"],
      "properties": {
        "profile_ref": {"$ref": "#/$defs/nonEmptyString"},
        "robot_index": {"const": 0},
        "actors": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/actor"}
        }
      }
    },
    "physicsAuthoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "local_colliders", "local_rigid_body", "local_mass"],
      "properties": {
        "owner": {"const": "convert_asset_package"},
        "local_colliders": {"const": false},
        "local_rigid_body": {"const": false},
        "local_mass": {"const": false}
      }
    },
    "framePose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["xyz", "wxyz"],
      "properties": {
        "xyz": {"$ref": "#/$defs/number3"},
        "wxyz": {"$ref": "#/$defs/quaternion"}
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_object_id",
        "role",
        "source_prim_path",
        "runtime_uid",
        "state_prim_path",
        "initial_pose",
        "named_frames"
      ],
      "properties": {
        "scenario_object_id": {"$ref": "#/$defs/usdIdentifier"},
        "role": {"$ref": "#/$defs/nonEmptyString"},
        "source_prim_path": {"type": "string", "pattern": "^/"},
        "runtime_uid": {"$ref": "#/$defs/nonEmptyString"},
        "state_prim_path": {"type": "string", "pattern": "^/World/"},
        "initial_pose": {"$ref": "#/$defs/pose"},
        "named_frames": {
          "type": "object",
          "propertyNames": {"type": "string", "minLength": 1, "pattern": "^[^.]+$"},
          "additionalProperties": {"$ref": "#/$defs/framePose"}
        },
        "physics_authoring": {"$ref": "#/$defs/physicsAuthoring"}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "skill", "actors", "parameters"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "skill": {"$ref": "#/$defs/nonEmptyString"},
        "actors": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}},
        "parameters": {"type": "object"},
        "depends_on": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}}
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "actor", "object", "from_step", "through_step"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "type": {"$ref": "#/$defs/nonEmptyString"},
        "actor": {"$ref": "#/$defs/nonEmptyString"},
        "object": {"$ref": "#/$defs/nonEmptyString"},
        "from_step": {"$ref": "#/$defs/nonEmptyString"},
        "through_step": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "diagnosticCompatibilityProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "parameters"],
      "properties": {
        "type": {"enum": ["relative_pose_reached", "object_at_initial_pose"]},
        "parameters": {"type": "object"}
      }
    },
    "namedFramesRelativePosePredicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "sequence_index", "parameters"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "type": {"const": "named_frames_relative_pose_reached"},
        "sequence_index": {"const": 0},
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_frame",
            "target_frame",
            "horizontal_error_max_m",
            "signed_height_range_m",
            "source_normal_axis",
            "target_normal_axis",
            "normal_angle_max_deg",
            "bounds",
            "diagnostic_compatibility_projection"
          ],
          "properties": {
            "source_frame": {"$ref": "#/$defs/nonEmptyString"},
            "target_frame": {"$ref": "#/$defs/nonEmptyString"},
            "horizontal_error_max_m": {"type": "number", "minimum": 0},
            "signed_height_range_m": {
              "type": "array",
              "prefixItems": [{"type": "number"}, {"type": "number"}],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "source_normal_axis": {"const": "z"},
            "target_normal_axis": {"const": "z"},
            "normal_angle_max_deg": {
              "type": "number",
              "minimum": 0,
              "maximum": 180
            },
            "bounds": {"const": "inclusive"},
            "diagnostic_compatibility_projection": {
              "$ref": "#/$defs/diagnosticCompatibilityProjection"
            }
          }
        }
      }
    },
    "namedFrameTiltPredicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "sequence_index", "parameters"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "type": {"const": "named_frame_tilt_angle_reached"},
        "sequence_index": {"const": 1},
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "object_frame",
            "world_axis",
            "angle_range_deg",
            "bounds",
            "diagnostic_compatibility_projection"
          ],
          "properties": {
            "object_frame": {"$ref": "#/$defs/nonEmptyString"},
            "world_axis": {"const": "z"},
            "angle_range_deg": {
              "type": "array",
              "prefixItems": [
                {"type": "number", "minimum": 0, "maximum": 180},
                {"type": "number", "minimum": 0, "maximum": 180}
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "bounds": {"const": "inclusive"},
            "diagnostic_compatibility_projection": {
              "$ref": "#/$defs/diagnosticCompatibilityProjection"
            }
          }
        }
      }
    },
    "postWarmupReturnPredicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "sequence_index", "parameters"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "type": {"const": "object_returned_to_post_warmup_pose"},
        "sequence_index": {"const": 2},
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "object",
            "translation_error_max_m",
            "rotation_error_max_deg",
            "bounds",
            "diagnostic_compatibility_projection"
          ],
          "properties": {
            "object": {"$ref": "#/$defs/nonEmptyString"},
            "translation_error_max_m": {"type": "number", "minimum": 0},
            "rotation_error_max_deg": {
              "type": "number",
              "minimum": 0,
              "maximum": 180
            },
            "bounds": {"const": "inclusive"},
            "diagnostic_compatibility_projection": {
              "$ref": "#/$defs/diagnosticCompatibilityProjection"
            }
          }
        }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "claim_scope", "predicates"],
      "properties": {
        "operator": {"const": "all"},
        "claim_scope": {"$ref": "#/$defs/nonEmptyString"},
        "predicates": {
          "type": "array",
          "prefixItems": [
            {"$ref": "#/$defs/namedFramesRelativePosePredicate"},
            {"$ref": "#/$defs/namedFrameTiltPredicate"},
            {"$ref": "#/$defs/postWarmupReturnPredicate"}
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        }
      }
    }
  }
}
