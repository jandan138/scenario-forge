{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenario-forge.local/schemas/phase11-visual-review-gate-v0.1.schema.json",
  "title": "Scenario Forge Phase 11 Visual Review Gate v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "phase",
    "status",
    "package_id",
    "task_id",
    "visual_review",
    "blockers",
    "next_stage",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "phase11-visual-review-gate/v0.1"
    },
    "phase": {
      "const": "11.0"
    },
    "status": {
      "enum": ["passed", "failed"]
    },
    "package_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "visual_review": {
      "type": "object"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_stage": {
      "enum": ["eos_task_execution_integration", "blocked"]
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
