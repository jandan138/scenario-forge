<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="light"><meta name="description" content="Task10 真液体滴定教程：粒子分组、实际接收计量、独立材质与连续显色。完全离线、自包含。">
<title>一滴液体，何时变色？｜Task10 真液体滴定教程</title>
<style>
:root{--paper:#eef5f9;--white:#fff;--ink:#132c43;--muted:#526b7f;--blue:#175ba5;--pink:#bb3974;--line:#c7d9e5;--soft:#e2edf5;--good:#17684c;--radius:16px}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:26px}body{margin:0;background:var(--paper);color:var(--ink);font-family:"PingFang SC","Microsoft YaHei","Noto Sans CJK SC",sans-serif;line-height:1.85}a{color:var(--blue);text-underline-offset:4px}button,input{font:inherit}button{cursor:pointer}button:focus-visible,a:focus-visible,input:focus-visible,summary:focus-visible{outline:3px solid var(--blue);outline-offset:4px}button{border:1px solid var(--line);border-radius:8px;padding:8px 15px;background:white;color:var(--ink);line-height:1.6}button:hover{background:var(--soft)}button.primary{background:var(--blue);border-color:var(--blue);color:white}button[aria-pressed="true"]{border-color:var(--blue);background:var(--soft);box-shadow:inset 0 -3px var(--blue)}button:disabled{cursor:default;opacity:.55}header{background:var(--white);border-bottom:1px solid var(--line)}.topline{max-width:1160px;margin:auto;padding:21px 30px;display:flex;justify-content:space-between;gap:12px;color:var(--muted);font-size:13px;letter-spacing:.06em}.brand{font-weight:750;color:var(--blue)}.hero{max-width:1100px;margin:auto;padding:45px 0 48px;display:grid;grid-template-columns:1.3fr 1fr;gap:45px;align-items:center}.eyebrow{text-transform:uppercase;color:var(--blue);font-size:13px;font-weight:700;letter-spacing:.13em}h1{font-family:"Songti SC","Noto Serif CJK SC","SimSun",serif;font-size:clamp(35px,5.3vw,63px);line-height:1.2;letter-spacing:-.025em;margin:18px 0 25px;font-weight:800}h1 em{font-style:normal;color:var(--pink)}.lead{font-size:19px;line-height:1.85;max-width:660px}.hero-aside{border-left:3px solid var(--blue);padding:7px 0 7px 24px}.hero-aside p{margin:7px 0}.kicker{font-size:12px;text-transform:uppercase;letter-spacing:.15em;color:var(--muted)}.source-mark{display:inline-block;border:1px solid var(--line);border-radius:30px;padding:2px 10px;font-size:12px;color:var(--muted)}main{max-width:1100px;margin:auto;padding-bottom:65px}.toc{padding:20px 0;display:flex;flex-wrap:wrap;gap:10px 23px;font-size:14px;border-bottom:1px solid var(--line)}.toc a{text-decoration:none}.lesson{padding:48px 0 12px}.chapter{display:flex;align-items:baseline;gap:14px}.chapter .n{color:var(--blue);font:600 14px ui-monospace,SFMono-Regular,Consolas,monospace;white-space:nowrap}h2{font-size:clamp(24px,3vw,33px);line-height:1.45;margin:0 0 18px;letter-spacing:-.025em}h3{font-size:19px;line-height:1.55;margin:0 0 12px}p{margin:12px 0}strong{font-weight:750}.intro{font-size:17px;max-width:880px}.panel{background:white;border:1px solid var(--line);border-radius:var(--radius);padding:25px;margin:22px 0}.callout{border-left:4px solid var(--pink);padding:14px 20px;background:#fff3f8;margin:20px 0}.callout.blue{border-color:var(--blue);background:#e7f1fa}.small{font-size:13px;color:var(--muted)}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:22px}.grid2>.panel{margin:12px 0}.tag{display:inline-block;font:600 12px ui-monospace,SFMono-Regular,Consolas,monospace;padding:2px 8px;border-radius:5px;background:var(--soft);color:var(--blue)}.tag.receiver{background:#fbe6ef;color:var(--pink)}.table-wrap{overflow-x:auto;max-width:100%;margin:20px 0;border:1px solid var(--line);border-radius:12px;background:white}table{border-collapse:collapse;width:100%;font-size:15px;min-width:620px}th,td{text-align:left;vertical-align:top;padding:15px 18px;border-bottom:1px solid var(--line)}th{background:#e4eef5;font-size:13px;color:var(--muted)}tr:last-child td{border-bottom:0}.flow{display:grid;grid-template-columns:repeat(3,1fr);gap:0;margin:25px 0}.flow article{padding:0 25px;border-left:1px solid var(--line)}.flow article:first-child{padding-left:0;border:0}.stepnum{display:inline-flex;width:28px;height:28px;align-items:center;justify-content:center;border-radius:50%;background:var(--blue);color:white;font-size:13px;margin-bottom:12px}.stepnum.pink{background:var(--pink)}.workbench{display:grid;grid-template-columns:1.25fr 1fr;gap:26px;align-items:center}.diagram{width:100%;height:auto;display:block}.diagram text{font-family:"PingFang SC","Microsoft YaHei",sans-serif;fill:var(--ink)}.diagram .svg-small{font-size:13px;fill:var(--muted)}.diagram .svg-label{font-size:16px;font-weight:700}.step-status{font-size:21px;line-height:1.6;font-weight:750;min-height:66px;margin:15px 0}.controls{display:flex;flex-wrap:wrap;gap:8px;margin:14px 0}.ledger{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.ledger div{border-top:3px solid var(--line);padding:11px 5px}.ledger b{display:block;font:700 22px ui-monospace,Consolas,monospace}.ledger span{font-size:12px;color:var(--muted)}.ledger .received{border-color:var(--pink)}.result{padding:12px 15px;background:var(--soft);border-radius:8px;margin-top:14px;min-height:72px}.result.good{background:#e2f3eb;color:var(--good)}label{display:block;font-weight:600;margin:12px 0 6px}input[type=range]{width:100%;accent-color:var(--blue);height:26px}input[type=checkbox]{width:18px;height:18px;accent-color:var(--blue);vertical-align:middle;margin-right:7px}.dose-number{font:700 clamp(32px,5vw,51px) ui-monospace,Consolas,monospace;letter-spacing:-.05em;line-height:1.3}.unit{font-size:16px;letter-spacing:0;color:var(--muted)}.swatch{width:100%;height:105px;border-radius:11px;border:1px solid var(--line);margin:14px 0;display:flex;align-items:center;justify-content:center;color:var(--ink);font-weight:700}.formula{padding:16px 18px;background:#e8f0f6;font-family:ui-monospace,SFMono-Regular,Consolas,"Microsoft YaHei",monospace;line-height:1.8;border-radius:8px;overflow-wrap:anywhere;margin:16px 0}.chart{width:100%;display:block;margin:18px 0}.phase-strip{display:flex;height:9px;border-radius:5px;overflow:hidden;margin-top:14px}.phase-strip span:nth-child(1){background:#dcecf4;flex:13.636}.phase-strip span:nth-child(2){background:linear-gradient(90deg,#e3eef8,#ffccdF);flex:1.364}.phase-strip span:nth-child(3){background:#ffccdf;flex:1.925}.phase-strip span:nth-child(4){background:linear-gradient(90deg,#ffccdf,#d91f47);flex:3.075}.proof-image{display:block;width:100%;height:auto;border:1px solid var(--line);border-radius:10px}.codebox{background:#183149;color:#eaf3fb;border-radius:10px;padding:20px;overflow:auto;font:13px/1.9 ui-monospace,SFMono-Regular,Consolas,monospace;tab-size:2;white-space:pre;max-width:100%}code{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:.91em;overflow-wrap:anywhere}.checklist{padding-left:22px}.checklist li{padding:4px 0}details{border-bottom:1px solid var(--line);padding:15px 0}summary{font-weight:700;cursor:pointer;line-height:1.6}details p{padding-left:18px;max-width:890px}.quiz{border-top:1px solid var(--line);padding:17px 0}.quiz p{font-weight:600}.quiz-answer{margin-top:12px;color:var(--blue);min-height:28px}.footer{border-top:1px solid var(--line);margin-top:40px;padding-top:22px;color:var(--muted);font-size:13px}.source-list{overflow-wrap:anywhere;font-size:13px}.print-button{font-size:12px;padding:3px 10px}.screen-reader{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}#drop{transition:transform .45s ease} @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}#drop{transition:none}}@media(max-width:1160px){main,.hero{margin-left:25px;margin-right:25px}}@media(min-width:761px) and (max-width:950px){.workbench{grid-template-columns:1fr}.diagram{max-width:550px;margin:auto}}@media(max-width:760px){.diagram .svg-small{display:none}.diagram .svg-label{font-size:24px}#arrivalBadge{font-size:22px}.table-wrap::after{content:"窄屏可横向滑动表格，查看右侧内容";display:block;padding:6px 12px;font-size:12px;color:var(--muted)}.hero{grid-template-columns:1fr;gap:18px;padding:25px 0 32px}.hero-aside{padding:5px 0 5px 16px}.topline{padding:16px 20px;letter-spacing:0;flex-wrap:wrap}main,.hero{margin-left:18px;margin-right:18px}.grid2,.workbench{grid-template-columns:1fr}.panel{padding:18px}.flow{grid-template-columns:1fr;gap:15px}.flow article,.flow article:first-child{border:0;border-top:1px solid var(--line);padding:16px 0 0}.lesson{padding-top:32px}.step-status{min-height:0}.lead{font-size:17px}.toc{gap:9px 17px}.chapter{gap:9px}.ledger b{font-size:20px}}@media print{body{background:white;color:black;font-size:11pt}main,.hero{max-width:none;margin:0}.hero{padding:10px 0;display:block}h1{font-size:28pt}.topline,.toc,.print-button,.controls,input,.interactive-only{display:none!important}.panel{break-inside:avoid;border:1px solid #bbb}.lesson{padding:22px 0 0}.grid2,.workbench{display:block}.proof-image{max-height:155mm;object-fit:contain}details{display:block}details>p{display:block}a{color:black}.footer{font-size:9pt}.codebox{background:#eee;color:black;white-space:pre-wrap}.callout{background:#fafafa}.diagram{max-height:110mm}}
</style>
</head>
<body>
<header><div class="topline"><span class="brand">SCENARIO FORGE · 场景原理讲义</span><span>Task10 · 真实液体 / 接收计量 / 连续显色 <button class="print-button" id="printBtn">打印 / 存为 PDF</button></span></div>
<div class="hero"><div><div class="eyebrow">跟着一滴液体，读懂整个过程</div><h1>上面还是清液，<br>下面为何<em>变粉红</em>？</h1><p class="lead">关键不在“哪一层屏幕被染色”，而在<strong>这粒液体属于哪个系统、是否真正被接收，以及代码改了哪一个材质</strong>。</p><span class="source-mark">当前 Task10 实现 · 2026-10-10 · 单文件离线教程</span></div><aside class="hero-aside"><div class="kicker">先记住三句话</div><p><strong>粒子系统</strong>负责液体的运动和归属。</p><p><strong>实际接收量</strong>决定锥形瓶应该呈现什么颜色。</p><p><strong>独立材质</strong>让瓶内显色不会染到滴定管。</p><p class="small">无需 Isaac Sim、无需联网即可阅读。页面交互是教学模型；文中的实际场景截图来自已验证的物理状态回放。</p></aside></div></header>
<main>
<nav class="toc" aria-label="教程目录"><a href="#parts">液体怎样分组</a><a href="#journey">一滴液体的旅程</a><a href="#volume">如何计量</a><a href="#color">交互变色实验</a><a href="#binding">为何上面不变色</a><a href="#evidence">实际画面</a><a href="#code">读代码与排查</a><a href="#questions">常见问题</a></nav>
<section class="lesson" id="parts"><div class="chapter"><span class="n">01 / 结构</span><h2>上下是分开的，但不是两层“假水”</h2></div><p class="intro">可以把整个场景理解成<strong>几组可以流动的“小水点”</strong>。每个点代表一小份液体，物理引擎计算它的运动；渲染器再把一群点包成连续的液面。你看到的是液面，不是一个个圆球。</p>
<div class="grid2"><article class="panel"><h3>粒子系统：管运动</h3><p>PBD 是基于位置约束的粒子方法。直观理解：引擎反复调整粒子的位置，处理液体内部的约束及与容器的碰撞，形成流动、起伏和下落。</p><p class="small">“真实液体”在这里指使用粒子物理，而不是固定形状的水网格；它仍是数值近似，并不等于完整真实化学或精确的微细阀道流动。</p></article><article class="panel"><h3>材质与等值面：管外观</h3><p>等值面可以理解成“包住这一群粒子的连续外皮”。材质再决定这层液面怎样透光、反射和着色。</p><p class="small">粒子在动和材质变色是两件事。液体可以真实流动，同时用一条任务规则决定整体颜色。</p></article></div>
<p>当前具体有四组，而不仅是上下两组：</p><div class="table-wrap"><table><thead><tr><th>系统名称</th><th>在什么地方</th><th>承担什么工作</th><th>颜色会变吗</th></tr></thead><tbody><tr><td><span class="tag">Source</span></td><td>滴定管上方储液柱</td><td>提供可释放的试剂；释放后相应扣除粒子</td><td>保持无色透明</td></tr><tr><td><span class="tag">DeadPrecharge</span></td><td>下方细管内的预充液</td><td>独立的精细 PBD 液体，保留细管内部的真实液体表现</td><td>保持无色透明</td></tr><tr><td><span class="tag">Falling</span></td><td>离开滴嘴、尚未被接收的液滴</td><td>计算实际下落；漏接的试剂也保留为物理粒子</td><td>保持无色透明</td></tr><tr><td><span class="tag receiver">Receiver</span></td><td>锥形瓶内的原液及已接收试剂</td><td>承接液滴，构成瓶内整体液面</td><td><strong>按实际接收量变色</strong></td></tr></tbody></table></div>
<div class="callout blue"><strong>“四组”是技术上的分工，不是四种化学物质。</strong>当前没有建立四种独立化学成分模型，也没有让上下液体共享一个会一起变色的材质实例。</div></section>
<section class="lesson" id="journey"><div class="chapter"><span class="n">02 / 转移</span><h2>从滴定管到锥形瓶，粒子如何“换组”</h2></div><div class="flow"><article><span class="stepnum">1</span><h3>出液：先扣，再生成</h3><p>根据旋塞角度和本步仿真时间计算剂量。从 <code>Source</code> 扣除对应数量的粒子，在滴嘴下生成等量 <code>Falling</code> 粒子。</p><p class="small">这是受控、守恒的源液体→滴嘴转移，不是让每粒都沿亚毫米阀道穿过旋塞。离开滴嘴后才由粒子物理计算下落。</p></article><article><span class="stepnum">2</span><h3>下落：经过瓶口还不够</h3><p>记录液滴是否<strong>真实向下穿过瓶口</strong>，再检查它是否接触瓶内的<strong>主体液体</strong>。在瓶颈里悬空，或只碰到孤立液滴，都不等同于被主体液体接收。</p></article><article><span class="stepnum pink">3</span><h3>接收：保留运动状态再合并</h3><p>符合条件的粒子从 <code>Falling</code> 移入 <code>Receiver</code>，<strong>保持接触时的位置和速度</strong>。随后计入接收量，并使用瓶内液体的材质。</p></article></div>
<div class="panel"><div class="kicker">动手看一遍 · 归属练习</div><h3>点击“下一步”，观察这批液滴何时计入瓶内</h3><p class="small">每批代表 8 个主体系粒子，共 0.027 mL。圆点数量、器材尺寸和位置仅为示意，图中浅蓝色用于看清无色液体。0.027 mL 本身不足以触发显色；变色规则在下一节单独演示。</p>
<div class="workbench"><svg class="diagram" viewBox="0 0 490 485" role="img" aria-labelledby="journeyTitle journeyDesc"><title id="journeyTitle">四个液体系统与液滴接收示意</title><desc id="journeyDesc">上方滴定管的储液柱、细管预充液、空中液滴和下方锥形瓶内液体分别属于不同系统。交互按钮可切换释放、穿口与接收状态。</desc><defs><pattern id="waterLines" width="9" height="9" patternUnits="userSpaceOnUse"><path d="M0 8H9" stroke="#a1c8e3" stroke-width="1"/></pattern></defs><rect x="25" y="20" width="440" height="445" rx="18" fill="#f3f8fb"/><path d="M70 443V82H150" fill="none" stroke="#7d96a9" stroke-width="9" stroke-linejoin="round"/><path d="M150 40V234Q150 251 174 253V308H186V253Q210 251 210 234V40" fill="#fff" stroke="#506b80" stroke-width="3"/><rect id="sourceFill" x="154" y="83" width="52" height="144" fill="#dfedf8"/><rect x="154" y="83" width="52" height="144" fill="url(#waterLines)"/><path d="M180 255V303" stroke="#8ab7d8" stroke-width="5"/><path d="M149 245H208" stroke="#175ba5" stroke-width="5"/><circle cx="180" cy="245" r="8" fill="#175ba5"/><path d="M158 333V374L112 434Q108 446 122 448H238Q252 446 248 434L202 374V333" fill="white" stroke="#506b80" stroke-width="3"/><path d="M125 412H235L246 435Q249 443 237 444H123Q111 443 114 435Z" fill="#dfedf8"/><path d="M125 412Q150 406 180 412T235 412" stroke="#8ab7d8" stroke-width="2" fill="none"/><line x1="146" y1="334" x2="215" y2="334" stroke="#175ba5" stroke-dasharray="4 4"/><text x="258" y="116" class="svg-label">Source</text><text x="258" y="138" class="svg-small">储液柱 · 独立透明材质</text><path d="M212 115H246" stroke="#7d96a9"/><text x="258" y="267" class="svg-label">DeadPrecharge</text><text x="258" y="288" class="svg-small">细管预充液 · 不参与显色</text><path d="M189 279H246" stroke="#7d96a9"/><text x="258" y="346" class="svg-label">Falling</text><text x="258" y="368" class="svg-small">尚未被主体液体接收</text><text x="258" y="423" class="svg-label" style="fill:#bb3974">Receiver</text><text x="258" y="445" class="svg-small">只有它的材质被更新</text><g id="drop" transform="translate(180 315)" visibility="hidden"><circle cy="0" r="5" fill="#175ba5"/><circle cx="-6" cy="-11" r="3" fill="#175ba5"/><circle cx="6" cy="-15" r="3" fill="#175ba5"/></g><text id="arrivalBadge" x="180" y="403" text-anchor="middle" fill="#175ba5" font-size="14" visibility="hidden">+8 粒</text></svg>
<div><label for="miss"><input type="checkbox" id="miss">演示漏接：液滴落在瓶外</label><p class="step-status" id="journeyStatus" aria-live="polite">准备出液：试剂还在滴定管里。</p><p id="journeyExplain">先观察三个独立数字。释放量、空中量和接收量不是同一件事。</p><div class="ledger"><div><b id="releasedCount">0</b><span>已释放 / 粒</span></div><div><b id="fallingCount">0</b><span>在途 / 粒</span></div><div class="received"><b id="receivedCount">0</b><span>已接收 / 粒</span></div></div><div class="result" id="ledgerText" aria-live="polite">已释放 0 = 在途 0 + 已接收 0 + 漏接 0</div><div class="controls"><button class="primary" id="journeyNext">下一步：释放</button><button id="journeyReset">重置这批液滴</button></div><p class="small">改变“漏接”选项会重置本练习。实际实现按每个粒子的唯一编号记账，避免同一滴重复计量。</p></div></div></div>
<p><strong>为什么不在“低于瓶口”时立刻计量？</strong>因为液滴可能从瓶子旁边掉下去，也可能在瓶颈内尚未碰到原液。当前实现同时检查瓶口穿越、容器内位置和主体液体接触，减少把悬空或漏接液滴误算成已接收的情况。</p></section>
<section class="lesson" id="volume"><div class="chapter"><span class="n">03 / 计量</span><h2>颜色看的不是开阀多久，而是实际收到了多少</h2></div><p class="intro">控制器给每个释放的试剂粒子一个唯一编号。满足接收条件后，这个编号进入“已接收”账目。瓶里原本就有的液体不会被算作新加入的试剂。</p><div class="formula">实际接收量 V = 有效接收的试剂粒子数 N × 0.003375 mL</div><div class="grid2"><article class="panel"><h3>一个实际数字</h3><p><strong>4,520 粒 × 0.003375 mL = 15.255 mL</strong></p><p>按两位小数显示，就是 <strong>15.26 mL</strong>。显示值经过四舍五入，内部判定仍使用实际累计值，不能拿屏幕的两位小数倒推精确粒子数。</p></article><article class="panel"><h3>“名义体积”是什么意思？</h3><p>它是该任务赋给主体系每个粒子的计量单位，不是从截图中量出来的体积，也不是每步重新积分渲染网格的体积。</p><p class="small">Source、Falling、Receiver 的主体系量子相同。细管 DeadPrecharge 使用更细的粒子分辨率，不能套用主体系每粒体积，也不加入显色剂量。</p></article></div>
<details><summary>屏幕都显示 15.00 mL，阶段为什么可能不同？</summary><p>4,444 粒对应 14.9985 mL，显示为 15.00 mL，但内部值还小于 15，仍在渐变阶段。4,445 粒对应 15.001875 mL，也显示为 15.00 mL，但已进入浅粉红窗口。两者肉眼可能很接近，阶段判定应以内部累计值为准。</p></details><div class="formula">已释放量 = 在途量 + 已接收量 + 漏接量</div><p class="small"><strong>别混淆两种分类：</strong>Falling 是物理粒子组，“在途 / 已接收 / 漏接”是剂量账目的状态。漏接后粒子仍可以留在 Falling，但不再计入在途量；如果后来满足真实接收条件，可以改记为已接收，仍不重复计量。</p><p>关阀后，管口不再释放新试剂，但空中的最后几滴仍可能入瓶。因此<strong>关阀后接收量和颜色仍可能短暂变化</strong>，直到剩余液滴完成下落。漏接粒子不会被凭空删除；账目将它们标为漏接，仍保留物理运动。</p>
<details><summary>开阀角度究竟控制了什么？</summary><p>它控制计划释放流量 Q。令 θ 为实际旋塞角度的绝对值，限制到 0～90°：θ≤5° 时 Q=0；否则 Q=(30/11)×(θ−5)/85 mL/s。最大流量约 2.727 mL/s，每个物理步再按仿真时间累积释放预算并换算为整粒数量。</p><p>5°＜θ＜15° 的小开度区间，当前账目按 8 粒一批释放。因此出液可以有离散的滴流节奏。累计预算不是已经入瓶的剂量；实际入瓶有飞行和接触延迟，还可能漏接。</p><p>本文介绍的已验证配置是 240 Hz，即每个物理步约 1/240 秒。这里所有“秒”都指仿真时间。</p></details></section>
<section class="lesson" id="color"><div class="chapter"><span class="n">04 / 显色</span><h2>一条连续曲线，驱动瓶内同一个材质</h2></div><p class="intro">当前没有计算真实 pH。代码把实际接收量 V 映射到一个 RGB 颜色，再写进瓶内液体材质。<strong>阶段名称是离散的，颜色在阶段边界连续衔接。</strong></p>
<div class="table-wrap"><table><thead><tr><th>实际接收量 V</th><th>阶段</th><th>写入的颜色</th></tr></thead><tbody><tr><td>V＜150/11 ≈13.63636 mL</td><td>无色</td><td>固定 (0.97, 0.99, 1.00)</td></tr><tr><td>150/11≤V＜15 mL</td><td>渐变</td><td>从无色线性过渡到浅粉红</td></tr><tr><td>15≤V≤3165/187 ≈16.92513 mL</td><td>浅粉红终点窗口</td><td>固定 (1.00, 0.80, 0.88)</td></tr><tr><td>V＞3165/187 mL</td><td>过量</td><td>继续加入的前 1 mL 内加深至 (0.85, 0.12, 0.28)，之后保持</td></tr></tbody></table></div>
<div class="callout blue">这些剂量阈值是<strong>当前任务的配置</strong>，不是所有酸碱滴定都通用的化学常数。更换试剂浓度、初始体积或实验目标时，不能直接照搬这条曲线。</div><div class="panel"><div class="kicker">动手看一遍 · 颜色与成功规则检查器</div><div class="grid2"><div><label for="dose">假设实际接收量为</label><div class="dose-number"><output id="doseRead" for="dose">0.000</output> <span class="unit">mL</span></div><input type="range" id="dose" min="0" max="20" step="0.001" value="0" aria-describedby="doseHelp"><div class="phase-strip" aria-hidden="true"><span></span><span></span><span></span><span></span></div><div class="controls" id="presets"><button data-dose="0">0</button><button data-dose="13.64">13.64</button><button data-dose="14.32">14.32</button><button data-dose="15.255">15.255</button><button data-dose="16.926">16.926</button><button data-dose="19.089">19.089</button></div><p class="small" id="doseHelp">这是可任意设定剂量的规则演示，不运行 PBD，也不模拟流量或化学。实际剂量按整粒数量离散增加，滑块的每个值不一定都能由整数粒子组成。往回拖滑块不会撤销已经锁定的成功或过量历史；开始新一轮请用“重置本轮”。</p><div class="swatch" id="swatch">颜色输入示意</div><p><strong id="phaseName">无色</strong> · <code id="phaseCode">colorless</code></p><p class="small">RGB 输入：<code id="rgbRead">(0.9700, 0.9900, 1.0000)</code><br>色块是浏览器对 RGB 的示意，不是 OmniGlass 渲染结果；真实外观还受折射、反射、背景和灯光影响。</p></div><div><h3>浅粉红 ≠ 立即成功</h3><p>进入浅粉红窗口后，还要<strong>关闭阀门并保持 3 个仿真秒</strong>。成功前如果已经过量，本轮不能再靠回到浅粉窗口获得成功。</p><label for="closed"><input type="checkbox" id="closed">阀门已关闭（≤5°）</label><div class="controls"><button class="primary" id="tick">推进 1 个仿真秒</button><button id="resetColor">重置本轮</button></div><div class="result" id="successState" aria-live="polite">尚未成功：先把剂量调到浅粉红窗口。</div><p><strong>有效保持时间：</strong><output id="holdRead">0</output> / 3 秒</p><p class="small">“推进”只演示保持判定，不自动增加剂量。成功会锁定：成功后继续过量，颜色仍会变深，但成功标记不会自动撤销。</p><div class="callout blue"><strong>试试看：</strong>重置 → 选 15.255 → 勾选关阀 → 点三次“推进” → 选 19.089。你会看到：颜色已经过量，但成功仍保留。</div></div></div></div>
<h3>渐变本质上是“按进度混合两组数值”</h3><p>从 13.63636… mL 到 15 mL，把进度 α 从 0 增加到 1。R、G、B 三个通道分别进行线性插值：</p><div class="formula">α = (V − 150/11) ÷ (15 − 150/11)<br>当前颜色 = 无色 RGB + α × (浅粉红 RGB − 无色 RGB)</div><p>例如 V≈14.31818 mL 时，进度约为一半，RGB≈(0.985, 0.895, 0.940)。继续加入后逐渐到达浅粉红，而不是切换到另一块粉色水网格。</p><p>超过浅粉窗口上限后，使用 β=min(1, V−3165/187)，把浅粉红插值到深色。这段变化占 1 mL；超过约 17.92513 mL 后，颜色就保持深色。</p></section>
<section class="lesson" id="binding"><div class="chapter"><span class="n">05 / 隔离</span><h2>为什么改下方材质，上方完全不受影响？</h2></div><p class="intro">因为“都用玻璃液体着色器”不等于“共用同一个材质实例”。就像两张表都使用同一种格式，修改其中一张表的数据，不会自动修改另一张。</p>
<div class="codebox" role="region" aria-label="粒子系统与独立材质映射" tabindex="0">/World/Task10Fluid/
├─ SourceSystem        → SourceMaterial / Shader         保持无色
├─ DeadPrechargeSystem → DeadPrechargeMaterial / Shader  保持无色
├─ FallingSystem       → FallingMaterial / Shader        保持无色
└─ ReceiverSystem      → ReceiverMaterial / Shader       ← 只写这里
                                        └─ inputs:glass_color</div><p>上面是 <strong>USD 场景中的节点路径</strong>，不是磁盘文件夹。Material 可以理解成一份外观配置；Shader 是实现这种外观的渲染程序；<code>inputs:glass_color</code> 是其中一个着色参数。代码找到 Receiver 的 Shader 后，只更新这个参数。</p>
<div class="grid2"><article class="panel"><h3>写入目标被明确限定</h3><p>初始化时，控制器只取得 <code>Receiver</code> 对应的 Shader。每步根据实际接收量计算颜色，改变的是这个 Shader 的 <code>inputs:glass_color</code>。</p><p>Source、DeadPrecharge 和 Falling 都有各自的材质路径，没有被这条显色更新语句改写。这是当前实现的分工方式，不是液体分色的唯一技术方案。</p></article><article class="panel"><h3>液滴入瓶后为什么能一起变色？</h3><p>被接收的粒子已经并入 Receiver，构成 Receiver 的等值面。它会使用同一个 ReceiverMaterial，因此自然呈现瓶内当前的颜色。</p><p>当前是<strong>整瓶统一更新颜色</strong>。不逐粒保存不同的染料浓度，也不会计算粉红色云团在瓶内扩散。</p></article></div>
<div class="callout"><strong>不是按世界高度做“上白下粉”的遮罩。</strong>即使移动锥形瓶，显色目标仍是 ReceiverMaterial。原理是粒子归属和材质绑定，而不是画面中的上下位置。</div>
<h3>变色时，透明度有没有一起调？</h3><p>当前只更新 <code>glass_color</code>。沿用 OmniGlass 的折射率 1.333、粗糙度 0.02、<code>thin_walled=False</code> 等设置；没有随剂量调整 opacity，也没有按阶段隐藏/替换几块水网格。<code>cutout_opacity=1</code> 不能单独理解成“液体不透明”——透射和折射由玻璃材质模型处理。</p></section>
<section class="lesson" id="evidence"><div class="chapter"><span class="n">06 / 对照</span><h2>把原理对应到实际场景画面</h2></div><p>下面三幅图来自 Isaac Sim 4.5 VR 包验证记录的粒子状态回放。切换图片观察锥形瓶的变化。它们不是本页面的教学动画，也不是实时运行的仿真。</p><div class="controls" id="photoButtons"><button data-photo="initial" aria-pressed="true">初始：无色</button><button data-photo="endpoint" aria-pressed="false">终点：浅粉红</button><button data-photo="overshoot" aria-pressed="false">过量：深色</button></div><figure style="margin:15px 0"><img class="proof-image" id="proofPhoto" width="1920" height="1080" src="__INITIAL_IMAGE__" alt="实际场景初始状态：锥形瓶内透明液体，显示屏为ON。"><figcaption class="small" id="photoCaption">初始接收量 0 mL。右上角 ON 是固定的文字网格；它不参与变色计算。</figcaption></figure><p class="small">画面里的 15.26 mL 是内部 15.255 mL 的两位小数显示。当前磁子保留视觉旋转动画；它没有物理搅拌功能，也不控制显色。</p></section>
<section class="lesson" id="code"><div class="chapter"><span class="n">07 / 实现</span><h2>用一段伪代码，把整条链路串起来</h2></div><p>下面省略了数组同步、质量更新、误差处理和粒子编号维护，只保留最重要的因果关系。它是讲解用伪代码，不应直接粘贴到场景运行。</p><pre class="codebox" tabindex="0"><code>每个物理步：
    读取实际旋塞角度、粒子位置与速度、瓶子实际位姿

    对 Falling 中的试剂粒子：
        如果真实向下穿过瓶口，并且接触瓶内主体液体：
            从 Falling 移除它
            将它的当前位置和速度加入 Receiver
            按唯一编号记为“已接收”
        否则：
            继续作为 Falling 运动，必要时记为“漏接”

    按角度 × 本步仿真时间累积释放预算
    从 Source 扣除对应整粒数量
    在滴嘴下生成等量 Falling 粒子

    V = 已接收试剂粒子数 × 每粒名义体积
    阶段, RGB = indicator(V)
    ReceiverMaterial.Shader["inputs:glass_color"] = RGB

    检查关阀、浅粉窗口、过量历史和 3 秒保持条件
    更新剂量、颜色阶段、成功标记和有效性状态</code></pre>
<p>其中与“只让下方变色”直接相关的实际代码，可以缩成下面这几行：</p><pre class="codebox" tabindex="0"><code># 控制器初始化：仅取 Receiver 的 Shader
self.shader = stage.GetPrimAtPath(
    self.config['systems']['Receiver']['material_path'] + '/Shader'
)

# 每步更新：根据实际接收量计算颜色
phase, color = indicator(self.ledger.received_ml)
self.shader.GetAttribute('inputs:glass_color').Set(Gf.Vec3f(*color))</code></pre>
<h3>现场排查时，按这个顺序看</h3><ol class="checklist"><li><strong>先看控制器是否有效：</strong><code>titration:pbd_valid</code> 与 <code>titration:pbd_error</code>。控制器未执行或读取失败时，不要只从画面猜原因。</li><li><strong>再看是否真的接收：</strong><code>released_volume_ml</code> 增加而 <code>dispensed_volume_ml</code> 不增加，先检查液滴是否入瓶并接触主体液体，以及是否漏接。</li><li><strong>核对阶段与数值：</strong><code>indicator_phase</code> 与实际接收量是否符合阈值。阈值比较使用内部值，而不是四舍五入后的显示。</li><li><strong>核对材质绑定：</strong>Source 和 Receiver 是否误绑到了同一个 Material 或 Shader 实例；显色代码是否只写 Receiver 的 <code>glass_color</code>。</li><li><strong>最后看渲染条件：</strong>颜色输入正确却“看着发黑”，可能与反射、背景、光照或材质加载有关。不要直接用 shader RGB 预测截图像素。</li></ol>
<p class="small">遥测通常在 <code>/World/obj_titration_station</code> 上；VR 挂载后前缀为 <code>/World/_scene</code>。相应的材质路径也随挂载改变，控制器按当前场景根解析路径。</p></section>
<section class="lesson" id="questions"><div class="chapter"><span class="n">08 / 自查</span><h2>容易混淆的几件事</h2></div>
<details open><summary>用的是同一种液体，为什么可以有不同颜色？</summary><p>数值物理属性与渲染颜色分开设置。当前各组都是 PBD 液体，但材质实例不同。颜色并不是自动从粒子的物理身份推导出来的化学性质，而是由任务控制器指定的表现。</p></details>
<details><summary>滴进粉色液体里的无色液滴，会逐渐被“染上”吗？</summary><p>当前在接收并合并进 Receiver 后，它就由 Receiver 的整体材质表现。没有求解每粒染料浓度，也没有从入滴点逐渐扩散的局部染色过程。要实现那种效果，需要增加组分输运/混合模型及相应的局部渲染方法。</p></details>
<details><summary>关阀之后颜色还在变，是不是程序错误？</summary><p>不一定。此前释放的液滴可能还在下落，实际接收量仍会增加，颜色也会继续更新。应一起看在途量、接收量和释放量；只有剩余液滴处理完后才应趋于稳定。</p></details>
<details><summary>成功后继续滴到深红，会取消成功吗？</summary><p>不会自动取消。当前成功标记是锁定的，但颜色仍跟随实时剂量变化。正式重置会清除剂量、阶段、过量历史、计时和成功标记，并恢复液体初态。采集端完整重置还需要恢复该轮容器位姿并关闭阀门。</p></details>
<details><summary>如果上下液体一起变色，优先检查哪里？</summary><p>先检查是否共享了同一个可修改的材质/Shader 实例，或者显色脚本是否误更新了全部液体材质。材质使用同一个 OmniGlass MDL 程序本身没有问题；关键是它们是否共享同一个参数实例。</p></details>
<details><summary>ON 和磁子转动，会影响变色速度吗？</summary><p>当前不会。ON 是原 OFF 文字网格替换后的静态显示。磁子保留视觉旋转时间采样，但未实现物理搅拌；显色由实际接收量驱动，与 ON 字样或磁子转速没有联动。</p></details>
<div class="panel"><h3>三个小问题，检查你是否理解</h3><div class="quiz" data-correct="b" data-answer="正确依据是实际接收：液滴只是穿过瓶口，还没接触主体液体，暂不计入显色剂量。"><p>① 液滴刚穿过瓶口，仍悬在瓶颈内。现在应计入显色剂量吗？</p><div class="controls"><button data-choice="a">应计入，已经在瓶子里</button><button data-choice="b">不应，尚未接触主体液体</button></div><div class="quiz-answer" aria-live="polite"></div></div><div class="quiz" data-correct="a" data-answer="Source、Falling、DeadPrecharge 与 Receiver 使用独立材质实例；代码只更新 Receiver 的 glass_color。"><p>② 上方不会跟着变色，最关键的原因是什么？</p><div class="controls"><button data-choice="a">独立材质，写入目标明确</button><button data-choice="b">代码把高处的颜色锁住了</button></div><div class="quiz-answer" aria-live="polite"></div></div><div class="quiz" data-correct="b" data-answer="成功还要求关阀保持3个仿真秒，而且成功前没有过量。浅粉红只是其中一个条件。"><p>③ 接收量 15.255 mL、浅粉红，但阀门仍开着，是否已经成功？</p><div class="controls"><button data-choice="a">已经成功</button><button data-choice="b">还没有，需要关阀并保持</button></div><div class="quiz-answer" aria-live="polite"></div></div></div>
</section>
<footer class="footer"><h3>这份教程对应哪一版？</h3><p>本文描述当前 Task10 真液体实现及其 Isaac Sim 4.5 VR 入口，不是旧版静态假液体教程。粒子物理、独立材质、接收量驱动显色是真实实现；页面中的 SVG、色块和按钮是教学示意，不进行 PBD、化学或真实搅拌计算。</p><div class="source-list"><p><strong>逻辑依据：</strong><code>scripts/task10_pbd_policy.py</code>（流量、剂量账目、indicator）；<code>scripts/task10_pbd_runtime.py</code>（穿口、主体接触、粒子合并、材质写入）。</p><p><strong>对应包：</strong><code>scientific_workbench_titration_task10_real_liquid_vr_r1</code>；VR 层另处理每轮初始化与重置，不改变上述显色曲线。</p><p><strong>实际画面：</strong>来自 <code>direct_full_05</code> 的合格物理快照，通过 <code>render_task10_vr.py</code> 回放；初始、终点、过量三帧的粒子位置与记录逐值一致。本文不声明头显实采成功或真实化学反应精度。</p><p><strong>离线说明：</strong>文字、样式、脚本、SVG 和三张实际场景图都在本文件内；没有 CDN、外部字体、网络请求或跟踪代码。浏览器禁用 JavaScript 时仍可阅读正文与初始截图。</p></div><p>制作日期：2026-10-10 · 基于当前代码与交付证据整理；未修改任务场景或物理参数。</p><noscript><p>JavaScript 已禁用：交互演示和图片切换不可用，正文仍可完整阅读。</p></noscript></footer>
</main>
<script>
'use strict';
const MAX_RATE=30/11, A=MAX_RATE*5, B=15, C=B+MAX_RATE*(40/85)*1.5;
function indicator(v){const clear=[.97,.99,1],pale=[1,.8,.88],deep=[.85,.12,.28];if(v<A)return {phase:'colorless',label:'无色',rgb:clear};if(v<B){const t=(v-A)/(B-A);return {phase:'transition',label:'由无色渐变到浅粉红',rgb:clear.map((a,i)=>a+(pale[i]-a)*t)}}if(v<=C)return {phase:'endpoint_pale_pink',label:'浅粉红终点窗口',rgb:pale};const t=Math.min(1,v-C);return {phase:'overshoot',label:'过量：继续加深',rgb:pale.map((a,i)=>a+(deep[i]-a)*t)}}
const byId=id=>document.getElementById(id);
let jStep=0;
function journey(){const miss=byId('miss').checked,release=jStep>0?8:0,received=jStep===3&&!miss?8:0,spilled=jStep===3&&miss?8:0,flight=release-received-spilled;byId('releasedCount').textContent=release;byId('receivedCount').textContent=received;byId('fallingCount').textContent=flight;byId('ledgerText').textContent=`已释放 ${release} = 在途 ${flight} + 已接收 ${received} + 漏接 ${spilled}；已接收 ${(received*.003375).toFixed(3)} mL`;const states=['准备出液：试剂还在滴定管里。','已经释放：液滴仍属于 Falling。',miss?'瓶子没接住：液滴正在瓶外下落。':'已穿过瓶口：还没碰到主体液体。',miss?'漏接：不增加接收量，也不推进显色。':'已接触主体液体：这批粒子并入 Receiver。'];const explanations=['先观察三个独立数字。释放量、空中量和接收量不是同一件事。','Source 扣除 8 粒，滴嘴下生成等量粒子。此刻还不能给瓶内剂量加数。',miss?'不能仅按“高度低于瓶口”就判定接收，还要判断实际位置和接触。':'穿口只是第一道条件。液滴在瓶颈里悬空时，接收量仍然为零。',miss?'粒子保留物理运动，只把账目状态改成漏接。本练习到这里结束。':'合并保留当前的位置与速度。实际代码只把它记为已接收一次。'];byId('journeyStatus').textContent=states[jStep];byId('journeyExplain').textContent=explanations[jStep];byId('drop').setAttribute('visibility',jStep>0&&!(jStep===3&&!miss)?'visible':'hidden');byId('drop').setAttribute('transform',`translate(${miss&&jStep>=2?95:180} ${jStep===1?316:jStep===2?368:434})`);byId('arrivalBadge').setAttribute('visibility',received?'visible':'hidden');byId('journeyNext').disabled=jStep===3;byId('journeyNext').textContent=['下一步：释放','下一步：经过瓶口',miss?'下一步：确认漏接':'下一步：接触主体液体','本批演示结束'][jStep]}
byId('journeyNext').addEventListener('click',()=>{jStep=Math.min(3,jStep+1);journey()});byId('journeyReset').addEventListener('click',()=>{jStep=0;journey()});byId('miss').addEventListener('change',()=>{jStep=0;journey()});
let hold=0,success=false,overHistory=false;
function refreshColor(){const v=Number(byId('dose').value),result=indicator(v);overHistory=overHistory||v>C;const eligible=byId('closed').checked&&v>=B&&v<=C&&!overHistory;if(!eligible)hold=0;byId('doseRead').textContent=v.toFixed(3);byId('phaseName').textContent=result.label;byId('phaseCode').textContent=result.phase;byId('rgbRead').textContent='('+result.rgb.map(x=>x.toFixed(4)).join(', ')+')';byId('swatch').style.backgroundColor='rgb('+result.rgb.map(x=>Math.round(x*255)).join(',')+')';const linear=result.rgb.map(x=>x<=.04045?x/12.92:((x+.055)/1.055)**2.4);const luminance=.2126*linear[0]+.7152*linear[1]+.0722*linear[2];byId('swatch').style.color=luminance>.179?'#000':'#fff';byId('holdRead').textContent=Math.min(3,hold);let message=success?(v>C?'已成功（已锁定）；当前颜色已过量。':'已成功：浅粉红关阀保持已满 3 秒。'):overHistory?'本轮曾经过量，不能获得新的成功；请重置本轮。':!byId('closed').checked?'尚未成功：请关闭阀门。':v<B?'尚未成功：接收量还没有进入浅粉红窗口。':`尚未成功：有效保持 ${hold} / 3 个仿真秒。`;byId('successState').textContent=message;byId('successState').classList.toggle('good',success);return eligible}
byId('dose').addEventListener('input',refreshColor);byId('closed').addEventListener('change',refreshColor);byId('presets').addEventListener('click',e=>{const b=e.target.closest('button[data-dose]');if(b){byId('dose').value=b.dataset.dose;refreshColor()}});byId('tick').addEventListener('click',()=>{if(refreshColor())hold+=1;if(hold>=3)success=true;refreshColor()});byId('resetColor').addEventListener('click',()=>{hold=0;success=false;overHistory=false;byId('dose').value=0;byId('closed').checked=false;refreshColor()});
const photos={initial:{src:byId('proofPhoto').src,alt:'初始状态：锥形瓶液体透明，实际接收量为零，显示屏为ON。',caption:'初始接收量 0 mL。右上角 ON 是固定的文字网格；它不参与变色计算。'},endpoint:{src:'__ENDPOINT_IMAGE__',alt:'实际浅粉红终点：接收量和释放量显示15.26mL，成功已确认，上方显示ON。',caption:'实收 15.255 mL，显示为 15.26 mL。关阀保持后成功锁定；瓶内浅粉红，其他系统不被这条显色逻辑修改。'},overshoot:{src:'__OVERSHOOT_IMAGE__',alt:'重置后另一轮过量状态：液体深红，接收量和释放量显示19.09mL，任务未成功。',caption:'这是重置后的另一轮过量测试：实收 19.089 mL，颜色明显加深，本轮没有成功。并非前一张已成功场景继续滴液后的状态。'}};
byId('photoButtons').addEventListener('click',e=>{const b=e.target.closest('button[data-photo]');if(!b)return;const p=photos[b.dataset.photo];byId('proofPhoto').src=p.src;byId('proofPhoto').alt=p.alt;byId('photoCaption').textContent=p.caption;document.querySelectorAll('[data-photo]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)))});
document.querySelectorAll('.quiz').forEach(q=>q.addEventListener('click',e=>{const b=e.target.closest('[data-choice]');if(!b)return;q.querySelector('.quiz-answer').textContent=(b.dataset.choice===q.dataset.correct?'答对了。':'再想一步：')+q.dataset.answer}));
const printDetails=new Map();window.addEventListener('beforeprint',()=>{document.querySelectorAll('details').forEach(d=>{printDetails.set(d,d.open);d.open=true})});window.addEventListener('afterprint',()=>{printDetails.forEach((open,d)=>{d.open=open});printDetails.clear()});byId('printBtn').addEventListener('click',()=>window.print());journey();refreshColor();
</script>
</body></html>
